---
layout: null
---
[
    {% for post in site.posts %
    }
    {
        "title": "{{ post.title | escape }}",
        "url": "{{ site.baseurl }}{{ post.url }}",
        "date": "{{ post.date | date: "%B %-d, %Y" }}",
        "tags": [
            {% for tag in post.tags %
            }
          "{{ tag }}"{% unless forloop.last %
            },
            {% endunless %
            }
        {% endfor %
            }
        ]
    }{% unless forloop.last %
    },
    {% endunless %
    }
  {% endfor %
    }
]